# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=congregation_db
DB_USER=congregation
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── JWT — generate both with: ──────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_byte_hex
JWT_EXPIRES_IN=4h
JWT_GRADUATE_EXPIRES_IN=24h

# ── QR HMAC — generate with: ──────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET=CHANGE_ME_32_byte_hex

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="University Congregation <noreply@university.edu>"

# ── CORS — comma-separated list of allowed frontend origins ──────────────────
CORS_ORIGINS=https://congregation.university.edu,https://admin.congregation.university.edu,https://gate.congregation.university.edu

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://api.congregation.university.edu
PORTAL_URL=https://congregation.university.edu

# ── Seed — only used by `make seed` (run once after first deploy) ─────────────
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_initial_password

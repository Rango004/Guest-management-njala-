# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/congregation_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=congregation_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_secret
JWT_EXPIRES_IN=4h
JWT_GRADUATE_EXPIRES_IN=24h

# QR HMAC — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET=replace_with_32_byte_hex_secret

# Email (SMTP)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM="University Congregation <noreply@university.edu>"

# App URLs
APP_BASE_URL=https://api.congregation.university.edu
PORTAL_URL=https://portal.congregation.university.edu

# Seed script — initial super-admin (only used by `npm run db:seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
